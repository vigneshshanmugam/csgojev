# The bot's body for brain comparisons: frozen, so only the decision-maker
# changes between runs. compare.sh applies these and copies them into every
# run log. Change them only between whole comparisons, never within one.

# Both sides carry this weapon. The machine's moves and Jev's brief describe an
# AWP (one-shot kill, bolt cycle), so keep it unless the brief changes too.
WEAPON=weapon_awp
# Aim: degrees per second the view can turn, scope on, no pre-aim.
TURN=220
SCOPE=1
PREAIM=0
# Opponent: zBot difficulty 0 easy, 1 normal, 2 hard, 3 expert. The opponent
# is an experiment variable, so DIFFICULTY=3 cs16/compare.sh overrides it.
DIFFICULTY=${DIFFICULTY:-2}
